      "ExperimentRow": {
        "description": "One metric from the policy backtest readout.\n\n`delta` is a difference-in-differences and is NOT `policy_b - policy_a`: it\nremoves the pre-period gap between the two groups and anything that hit both\narms on the same day. A consumer that subtracts the two columns will get a\ndifferent, wrong number, which is why the delta is served rather than left\nto be derived.\n\n`not_applicable_reason` is set on rows the holdout cannot answer, and those\nrows carry nulls rather than zeros. A zero would render as a measured result\nof no effect, which is the opposite of what is meant.",
        "properties": {
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci High"
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci Low"
          },
          "delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta"
          },
          "display_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Delta"
          },
          "display_policy_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Policy A"
          },
          "display_policy_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Policy B"
          },
          "display_unit": {
            "title": "Display Unit",
            "type": "string"
          },
          "is_measured": {
            "title": "Is Measured",
            "type": "boolean"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Not Applicable Reason"
          },
          "policy_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy A"
          },
          "policy_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy B"
          },
          "seeds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seeds"
          },
          "significant": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Significant"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
