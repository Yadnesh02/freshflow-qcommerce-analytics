      "WarehouseCatalogueResponse": {
        "description": "Everything the open warehouse holds, which is not the same set in every build.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Relation"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "WarehouseCatalogueResponse",
        "type": "object"
      },
      "WarehouseRowsResponse": {
        "description": "A page of stored rows. `meta.sql` is the statement that produced exactly this grid.",
        "properties": {
          "data": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "WarehouseRowsResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Every number here is compiled from semantic/metrics.yml. Responses echo the SQL they ran and the metric definition they compiled, so any figure can be traced back to its declaration.",
    "title": "FreshFlow Metrics API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions/expiry": {
      "get": {
        "description": "Batches worth acting on, most valuable first.\n\nFiltered to `at_risk` by default and deliberately: already-expired stock is\na real loss and appears in the wastage metrics, but no markdown recovers it,\nso putting it in an action queue would give someone a list they cannot act\non ranked above one they can.",
        "operationId": "expiry_queue_actions_expiry_get",
        "parameters": [
          {
            "description": "Store id, e.g. `FF-BAN-01`",
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store id, e.g. `FF-BAN-01`",
              "title": "Store"
            }
          },
          {
            "description": "Rupees at risk, at least",
            "in": "query",
            "name": "min_value",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "Rupees at risk, at least",
              "minimum": 0,
              "title": "Min Value",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpiryQueueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The ranked action queue"
      }
    },
    "/actions/queue": {
      "get": {
        "description": "The four decision engines' output as one ranked list.\n\nGrouped by engine, ranked by value within each. Not ranked globally: the\nfour engines measure different rupees. A replenishment line's value is money\nabout to be committed; a transfer's is a write-off avoided. Sorting those\nagainst one another puts every purchase order above every transfer and reads\nas a priority ordering, which it is not. `value_basis` says what each number\nis so nothing downstream has to guess.\n\nA missing table is not an error here. The engines are built and run\nindependently, so this returns whatever exists and names what does not -\na queue that 503s because one optimiser has not been run yet is useless on\nexactly the day somebody needs the other three.",
        "operationId": "action_queue_actions_queue_get",
        "parameters": [
          {
            "description": "Store id, e.g. `FF-BAN-01`",
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store id, e.g. `FF-BAN-01`",
              "title": "Store"
            }
          },
          {
            "description": "markdown | deal_slot | transfer | replenish",
            "in": "query",
            "name": "action_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "markdown | deal_slot | transfer | replenish",
              "title": "Action Type"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionQueueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Everything to do today"
      }
    },
    "/elasticity": {
      "get": {
        "description": "The demand curves S4.2 prices against, including the ones that are not there.\n\nNine of twenty-three cells could not be identified: their confidence\nintervals cover zero, and two of the thin ones came back at +8.60 and +1.61,\nwhich is a Poisson fit dividing by a price series with no variation in it\nrather than a finding. They are returned by default and flagged, because a\nchart of only the cells that worked would show a tidy demand curve across\nevery category and imply the last day was measured. It was not, in any\ncategory.",
        "operationId": "elasticity_elasticity_get",
        "parameters": [
          {
            "description": "L1 category, e.g. `Dairy & Eggs`",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "L1 category, e.g. `Dairy & Eggs`",
              "title": "Category"
            }
          },
          {
            "description": "Drop cells where no price response was established",
            "in": "query",
            "name": "identified_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Drop cells where no price response was established",
              "title": "Identified Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElasticityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Price response by category and freshness"
      }
    },
    "/experiment": {
      "get": {
        "description": "What the backtest concluded, including the rows it could not conclude.\n\nThe north star comes first, and it is the one that matters: Policy B raises\navailability and gross margin and roughly doubles wastage, so on gross\nmargin after wastage it is worse than the status quo. A readout carrying\nonly the margin level would have reported a win - the level rises because\nPolicy B sells more - which is precisely why the registry names a rate as\nthe north star and why this table serves it first.\n\nRows the holdout cannot answer are returned with nulls and a reason rather\nthan omitted. Ninety-day retention is customer-level while the holdout\nrandomises stores; forecast WAPE is a property of Policy B's forecast, and\nPolicy A does not forecast. Dropping them would read as an oversight and\nfilling them would be invention.",
        "operationId": "experiment_experiment_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The policy A/B readout"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and what this instance is reading"
      }
    },
    "/health/freshness": {
      "get": {
        "description": "How far behind each source feed is, and which have breached.\n\nRead from dq_source_coverage rather than from max(date) on each fact,\nbecause a feed that stopped arriving looks identical to one that had nothing\nto send unless something tracks the partitions it was supposed to produce.",
        "operationId": "freshness_health_freshness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreshnessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Source freshness SLA"
      }
    },
    "/health/quality": {
      "get": {
        "description": "The last Soda scan, and the defects the warehouse was built to repair.\n\nBoth inputs are files rather than tables - Soda runs outside this process\nentirely, for the dependency reasons in quality/soda/configuration.yml -\nso either can be missing without anything being wrong. A deployed instance\nthat fetched only the demo slice has neither, and says so in `unavailable`\nrather than returning a 404 that the page would have to translate.\n\nThe two travel together because a warning without its cause is an\nunexplained amber light. The clickstream outage warns on every healthy\nbuild, and the ledger is what makes that a known quantity instead of a nag\nsomebody eventually silences.",
        "operationId": "quality_health_quality_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The data-quality scan"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "list_metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Metrics Metrics Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List every metric the registry publishes"
      }
    },
    "/metrics/{name}": {
      "get": {
        "operationId": "get_metric_metrics__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Comma-separated, e.g. `store,week`",
            "in": "query",
            "name": "dimensions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated, e.g. `store,week`",
              "title": "Dimensions"
            }
          },
          {
            "description": "Comma-separated `dimension:value`, e.g. `store_tier:premium`",
            "in": "query",
            "name": "filters",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated `dimension:value`, e.g. `store_tier:premium`",
              "title": "Filters"
            }
          },
          {
            "description": "Capped at 5000",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capped at 5000",
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compute one metric"
      }
    },
    "/warehouse/catalogue": {
      "get": {
        "description": "Read from the database's own metadata, not from the dbt manifest.\n\nThe manifest says what the project would build; this says what the open file\ncontains, and on the published slice those differ by a dozen relations. The\npage needs the second one, or it offers the reader tables that are not there.",
        "operationId": "warehouse_catalogue_warehouse_catalogue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseCatalogueResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Every relation this build actually holds"
      }
    },
    "/warehouse/rows/{schema_name}/{table}": {
      "get": {
        "operationId": "warehouse_rows_warehouse_rows__schema_name___table__get",
        "parameters": [
          {
            "in": "path",
            "name": "schema_name",
            "required": true,
            "schema": {
              "title": "Schema Name",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "table",
            "required": true,
            "schema": {
              "title": "Table",
              "type": "string"
            }
          },
          {
            "description": "Capped at 5000",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capped at 5000",
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Must be a column of this relation",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Must be a column of this relation",
              "title": "Order By"
            }
          },
          {
            "in": "query",
            "name": "order_dir",
            "required": false,
            "schema": {
              "default": "asc",
              "pattern": "^([aA][sS][cC]|[dD][eE][sS][cC])$",
              "title": "Order Dir",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseRowsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A page of stored rows from one relation"
      }
    }
  }
}
