  "info": {
    "description": "Every number here is compiled from semantic/metrics.yml. Responses echo the SQL they ran and the metric definition they compiled, so any figure can be traced back to its declaration.",
    "title": "FreshFlow Metrics API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions/expiry": {
      "get": {
        "description": "Batches worth acting on, most valuable first.\n\nFiltered to `at_risk` by default and deliberately: already-expired stock is\na real loss and appears in the wastage metrics, but no markdown recovers it,\nso putting it in an action queue would give someone a list they cannot act\non ranked above one they can.",
        "operationId": "expiry_queue_actions_expiry_get",
        "parameters": [
          {
            "description": "Store id, e.g. `FF-BAN-01`",
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store id, e.g. `FF-BAN-01`",
              "title": "Store"
            }
          },
          {
            "description": "Rupees at risk, at least",
            "in": "query",
            "name": "min_value",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "Rupees at risk, at least",
              "minimum": 0,
              "title": "Min Value",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpiryQueueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The ranked action queue"
      }
    },
    "/actions/queue": {
      "get": {
        "description": "The four decision engines' output as one ranked list.\n\nGrouped by engine, ranked by value within each. Not ranked globally: the\nfour engines measure different rupees. A replenishment line's value is money\nabout to be committed; a transfer's is a write-off avoided. Sorting those\nagainst one another puts every purchase order above every transfer and reads\nas a priority ordering, which it is not. `value_basis` says what each number\nis so nothing downstream has to guess.\n\nA missing table is not an error here. The engines are built and run\nindependently, so this returns whatever exists and names what does not -\na queue that 503s because one optimiser has not been run yet is useless on\nexactly the day somebody needs the other three.",
        "operationId": "action_queue_actions_queue_get",
        "parameters": [
          {
            "description": "Store id, e.g. `FF-BAN-01`",
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store id, e.g. `FF-BAN-01`",
              "title": "Store"
            }
          },
          {
            "description": "markdown | deal_slot | transfer | replenish",
            "in": "query",
            "name": "action_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "markdown | deal_slot | transfer | replenish",
              "title": "Action Type"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionQueueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Everything to do today"
      }
    },
    "/elasticity": {
      "get": {
        "description": "The demand curves S4.2 prices against, including the ones that are not there.\n\nNine of twenty-three cells could not be identified: their confidence\nintervals cover zero, and two of the thin ones came back at +8.60 and +1.61,\nwhich is a Poisson fit dividing by a price series with no variation in it\nrather than a finding. They are returned by default and flagged, because a\nchart of only the cells that worked would show a tidy demand curve across\nevery category and imply the last day was measured. It was not, in any\ncategory.",
        "operationId": "elasticity_elasticity_get",
        "parameters": [
          {
            "description": "L1 category, e.g. `Dairy & Eggs`",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "L1 category, e.g. `Dairy & Eggs`",
              "title": "Category"
            }
          },
          {
            "description": "Drop cells where no price response was established",
            "in": "query",
            "name": "identified_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Drop cells where no price response was established",
              "title": "Identified Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElasticityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Price response by category and freshness"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and what this instance is reading"
      }
    },
    "/health/freshness": {
      "get": {
        "description": "How far behind each source feed is, and which have breached.\n\nRead from dq_source_coverage rather than from max(date) on each fact,\nbecause a feed that stopped arriving looks identical to one that had nothing\nto send unless something tracks the partitions it was supposed to produce.",
        "operationId": "freshness_health_freshness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreshnessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Source freshness SLA"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "list_metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Metrics Metrics Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List every metric the registry publishes"
      }
    },
    "/metrics/{name}": {
      "get": {
        "operationId": "get_metric_metrics__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Comma-separated, e.g. `store,week`",
            "in": "query",
            "name": "dimensions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated, e.g. `store,week`",
              "title": "Dimensions"
            }
          },
          {
            "description": "Comma-separated `dimension:value`, e.g. `store_tier:premium`",
            "in": "query",
            "name": "filters",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated `dimension:value`, e.g. `store_tier:premium`",
              "title": "Filters"
            }
          },
          {
            "description": "Capped at 5000",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capped at 5000",
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
