# ---- data (regenerate with `python tasks.py simulate`) ----
data/
*.duckdb
*.duckdb.wal
*.parquet
# The deployment slice is NOT committed. It ships as a GitHub Release asset and
# serving/demo_data.py fetches it; serving/demo/manifest.json pins the hash.
# Rationale in serving/demo_data.py - short version: DuckDB files are not
# byte-stable, so every rebuild would add a permanent ~69 MB blob to history.
serving/demo/.cache/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---- dbt ----
transform/target/
transform/dbt_packages/
transform/logs/
logs/
.user.yml

# ---- dagster ----
.dagster/
dagster_home/
tmp*/

# ---- secrets / local config ----
.env
.env.*
# transform/profiles.yml is committed on purpose: DuckDB is a local file and
# the profile holds no credentials. Real secrets go in env vars, never a file.

# ---- editors / os ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- scratch ----
scratch/
notebooks/scratch/
*.log
