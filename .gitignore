# ---- data (regenerate with `python tasks.py simulate`) ----
# `data/*` rather than `data/`, because git cannot re-include a file whose
# parent directory is excluded - an exception under a bare `data/` is silently
# ignored, which is how the first attempt at this failed.
data/*
# ...except the experiment readout, committed on purpose. S5.5's gate is that
# `mart_experiment_readout` rebuilds from committed results on any clone, and a
# table the reader must regenerate before they can see it is not a published
# result. Six rows and a few KB. The raw panels stay as CI artifacts: those are
# megabytes, and git history only grows.
*.duckdb
*.duckdb.wal
*.parquet
# The deployment slice is NOT committed. It ships as a GitHub Release asset and
# serving/demo_data.py fetches it; serving/demo/manifest.json pins the hash.
# Rationale in serving/demo_data.py - short version: DuckDB files are not
# byte-stable, so every rebuild would add a permanent ~69 MB blob to history.
serving/demo/.cache/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---- dbt ----
transform/target/
transform/dbt_packages/
transform/logs/
logs/
.user.yml

# ---- dagster ----
.dagster/
dagster_home/
tmp*/

# ---- secrets / local config ----
.env
.env.*
# transform/profiles.yml is committed on purpose: DuckDB is a local file and
# the profile holds no credentials. Real secrets go in env vars, never a file.

# ---- editors / os ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- scratch ----
scratch/
notebooks/scratch/
*.log

# Build outputs, not results. `warehouse.yml` writes the anchors, the published
# figures, the delivery-cost crossover and the Soda scan here and uploads the
# directory as part of the warehouse-build artifact - which is the point of
# them: they are read from a run, not from the repository. A committed copy
# would be a snapshot of whichever build last ran on somebody's laptop.
reports/

# The experiment readout is committed on purpose, and this exception sits last
# because the last matching rule wins: it has to come after both `data/*` and
# the blanket `*.parquet` above, either of which would otherwise re-exclude it.
#
# S5.5's gate is that `mart_experiment_readout` rebuilds from committed results
# on any clone, and a table the reader must regenerate before they can see it is
# not a published result. Six rows, a few KB. The raw panels stay as CI
# artifacts: megabytes each, and git history only grows.
!data/experiment/
!data/experiment/readout.parquet
